# Sample local.conf fragment for ARK Modalix carriers
# (setup.sh appends an equivalent block automatically)
#
# MACHINE choices:
#   ark-jaj      - ARK Just a Jetson
#   ark-pab      - ARK Jetson PAB
#   ark-pab-v3   - ARK Jetson PAB V3
#   ark-can-pab  - ARK Jetson CAN PAB

MACHINE ??= "ark-jaj"

# Accept SiMa commercial license flags (required by meta-simaai images)
LICENSE_FLAGS_ACCEPTED += "commercial"

# Drop meta-simaai sample internal mirror when building off-prem
SOURCE_MIRROR_URL = ""
INHERIT:remove = "own-mirrors"

PREFERRED_VERSION_linux-simaai = "6.18%"

# Optional: override serial baud
# BAUDRATE = "115200"
