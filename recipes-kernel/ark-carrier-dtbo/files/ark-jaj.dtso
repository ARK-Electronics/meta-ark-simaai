// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * ARK Just a Jetson (JAJ) carrier with SiMa.ai Modalix SoM
 *
 * Camera (schematic sheet 10 + Jetson connector sheets 5–7):
 *   - Shared CAM_I2C → FSUSB42UMX mux (U11) → CAM0 / CAM1 @ 0x10
 *   - CAM_MUX_SEL (J26B pin 130 / GPIO06) = port6 GPIO6  [SiMa dual-cam overlays]
 *   - CAM0/CAM1 PWDN enables = port5 GPIO6 + GPIO7 held high
 *   - J28 CAM0 2-lane: CSI1_D0/D1/CLK (D2/D3 = CSI0, 4-lane only)
 *   - J25 CAM1 2-lane: CSI2_D0/D1/CLK (D2/D3 = CSI3, 4-lane only)
 *   - Linux bus: i2c52 = i2c-4 = sio@5/i2c@0x04059000 (chip id 0x0219)
 *
 * UART (Modalix gold finger vs Jetson roles — see docs/bringup-jaj.md):
 *   - UART1 (SODIMM 203/205, SIO1[4]/[5], DT uart12 → ttyS0): generic app UART.
 *     Same net as on-module FTDI (SoM USB-C debug). TX/RX only (no RTS/CTS pinmux).
 *     NOTE: TX may not reach the gold finger. The stock SoM DT hogs SIO1_IO[2]
 *     ("usb_uart12", port1 line 2) output-high, which looks like the on-module
 *     USB-bridge/gold-finger select; and per pinctrl-simaai-sio.c the TX pad of a
 *     UART pair is the *upper* pin, so DS Table 2-9 has 203/205 crossed. Stack
 *     ark-jaj-uart1-carrier.dtbo to flip the hog. See docs/bringup-jaj.md.
 *   - UART0 (SODIMM 99/101, SIO4[5]/[4], DT uart42 → typically ttyS1): optional
 *     second UART / serial console if you free UART1 from console=ttyS0.
 *   - UART_B (SODIMM 236/238, JAJ silk “UART2”): tRoot only, not a Linux tty.
 *
 * USB-C: FUSB301 @ i2c00 0x25 (see ark-jaj-usb-init.sh for dual-role)
 */

/dts-v1/;
/plugin/;

&{/} {
	model = "ARK Just a Jetson with SiMa Modalix SoM";
	compatible = "ark,just-a-jetson", "simaai,modalix-som", "simaai,modalix";

	jaj_xclk0: jaj-xclk0 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		status = "okay";
	};

	jaj_xclk1: jaj-xclk1 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		status = "okay";
	};

	ark_jaj {
		compatible = "ark,just-a-jetson";
		status = "okay";
	};

	/*
	 * GPIO I2C mux for dual IMX219 (same address 0x10 on CAM_I2C).
	 * Must be a root node with i2c-parent, not a child of i2c52.
	 */
	cam_i2cmux: i2cmux {
		compatible = "i2c-mux-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		i2c-parent = <&i2c52>;
		/* CAM_MUX_SEL: Jetson GPIO06 → Modalix port6 line 6 (SiMa dual-cam DT) */
		mux-gpios = <&port6 6 0>;
		idle-state = <0>;

		/* CAM0 — CSI1 / J28 (CSI1_D0/D1/CLK) */
		i2c@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			jaj_imx219_0: imx219@10 {
				compatible = "sony,imx219";
				reg = <0x10>;
				status = "okay";
				clocks = <&jaj_xclk0>;
				clock-names = "xclk";
				rotation = <180>;
				orientation = <2>;

				port {
					jaj_cam0_ep: endpoint {
						clock-lanes = <0>;
						data-lanes = <1 2>;
						link-frequencies = /bits/ 64 <456000000>;
						remote-endpoint = <&csi10in>;
						clock-noncontinuous;
					};
				};
			};
		};

		/* CAM1 — CSI2 / J25 (CSI2_D0/D1/CLK) */
		i2c@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			jaj_imx219_1: imx219@10 {
				compatible = "sony,imx219";
				reg = <0x10>;
				status = "okay";
				clocks = <&jaj_xclk1>;
				clock-names = "xclk";
				rotation = <180>;
				orientation = <2>;

				port {
					jaj_cam1_ep: endpoint {
						clock-lanes = <0>;
						data-lanes = <1 2>;
						link-frequencies = /bits/ 64 <456000000>;
						remote-endpoint = <&csi20in>;
						clock-noncontinuous;
					};
				};
			};
		};
	};
};

/* ---- PWDN enables (port5); CAM_MUX_SEL is owned by i2c-mux-gpio on port6 ---- */

&port5 {
	/* Match SiMa dual-cam overlays: port5 GPIO6/7 = camera powerdown enables */
	cam0-pwdn-en {
		gpio-hog;
		gpios = <6 0>;
		output-high;
		line-name = "cam0_pwdn";
	};

	cam1-pwdn-en {
		gpio-hog;
		gpios = <7 0>;
		output-high;
		line-name = "cam1_pwdn";
	};
};

/* Parent bus for CAM_I2C (SoM → FSUSB42 mux → both cameras) */
&i2c52 {
	status = "okay";
	clock-frequency = <400000>;
};

/* ---- CSI1 (CAM0/J28) + CSI2 (CAM1/J25) pipelines ---- */
/* CSI0 unused on JAJ for dual IMX219 (no connector to CSI0 lanes). */

&csi0 {
	status = "disabled";
};

&csi1 {
	status = "okay";
};

&axi_vdma1 {
	status = "okay";
};

&mipi_dphy_rx1 {
	status = "okay";
};

&v4l2video1 {
	status = "okay";
};

&v4l2vdma1 {
	status = "okay";
};

&csi10in {
	clock-lanes = <0>;
	data-lanes = <1 2>;
	link-frequencies = /bits/ 64 <456000000>;
	remote-endpoint = <&jaj_cam0_ep>;
	clock-noncontinuous;
};

&csi2 {
	status = "okay";
};

&axi_vdma2 {
	status = "okay";
};

&mipi_dphy_rx2 {
	status = "okay";
};

&v4l2video2 {
	status = "okay";
};

&v4l2vdma2 {
	status = "okay";
};

&csi20in {
	clock-lanes = <0>;
	data-lanes = <1 2>;
	link-frequencies = /bits/ 64 <456000000>;
	remote-endpoint = <&jaj_cam1_ep>;
	clock-noncontinuous;
};

/* ---- Remove old wrong sensors on i2c00/i2c01 if re-applied ---- */
/* (fresh overlay replaces nodes only for targets we touch) */

/* FUSB301 Type-C on i2c00 (USB2 debug FTDI is separate on SoM) */
&i2c00 {
	status = "okay";
	clock-frequency = <400000>;
	#address-cells = <1>;
	#size-cells = <0>;

	jaj_fusb301: fusb301@25 {
		compatible = "fcs,fusb301", "onnn,fusb301";
		reg = <0x25>;
		status = "okay";

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			try-power-role = "source";
		};
	};
};

&i2c01 {
	status = "okay";
	clock-frequency = <400000>;
};

&i2c02 {
	status = "okay";
	clock-frequency = <400000>;
};

&pcie0_rc {
	status = "okay";
};

&pcie2_rc {
	status = "okay";
};

&pcie3_rc {
	status = "okay";
};

&xgmac0 {
	status = "okay";
};

/*
 * UART1 — generic (application) serial.
 * SoC: uart12 @ 0x0401a000, pinctrl uart2_group = SIO1 pins 4–5 (TX/RX only).
 * Electrically shared with SoM on-module FTDI (USB-C). Stock images also use this
 * as console=ttyS0; move console to UART0 (uart42) or drop serial console to use
 * exclusively from userspace (see docs/bringup-jaj.md).
 */
&uart12 {
	status = "okay";
};

/*
 * UART0 — second general-purpose UART on JAJ (header near UART0 silk / 3.3 V side).
 * SoC: uart42 @ 0x0404a000, SIO4 pins 4–5. Enable for console=ttyS1 when UART1
 * is reserved for an application.
 */
&uart42 {
	status = "okay";
};
