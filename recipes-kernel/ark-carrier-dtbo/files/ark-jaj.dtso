// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * ARK Just a Jetson (JAJ) carrier with SiMa.ai Modalix SoM
 *
 * Camera (schematic sheet 10 + Jetson connector sheets 5–7):
 *   - Shared CAM_I2C → FSUSB42UMX mux (U11) → CAM0 / CAM1 @ 0x10
 *   - CAM_MUX_SEL (J26B pin 130 / GPIO06) = port6 GPIO6  [SiMa dual-cam overlays]
 *   - CAM0/CAM1 PWDN enables = port5 GPIO6 + GPIO7 held high
 *   - J28 CAM0 2-lane: CSI1_D0/D1/CLK (D2/D3 = CSI0, 4-lane only)
 *   - J25 CAM1 2-lane: CSI2_D0/D1/CLK (D2/D3 = CSI3, 4-lane only)
 *   - Linux bus: i2c52 = i2c-4 = sio@5/i2c@0x04059000 (chip id 0x0219)
 *
 * UART (Modalix gold finger vs Jetson roles — see docs/bringup-jaj.md):
 *   - UART1 (SODIMM 203/205, SIO1[4]/[5], DT uart12 → ttyS0): generic app UART.
 *     Same net as on-module FTDI (SoM USB-C debug). TX/RX only (no RTS/CTS pinmux).
 *     The JAJ J6 header needs the two data wires SWAPPED vs the silkscreen: every
 *     SIO UART pair is even=RX / odd=TX, so SIO1[5] (=SODIMM 205, JAJ "UART1_RXD",
 *     J6 pin 3) is the SoC's TX and SIO1[4] (=SODIMM 203, J6 pin 2) is its RX.
 *     J6 pin 3 also needs a 3V3 pull-up added: U10 is an LSF0108 pass-FET
 *     translator and JAJ populates one pull-up per channel on the side that
 *     receives, so the net carrying the SoC's TX has its pull-up on the wrong
 *     side and only reaches ~1V8. Nothing here is fixable in DT.
 *   - UART0 (SODIMM 99/101, SIO4[5]/[4], DT uart42 → typically ttyS1): optional
 *     second UART / serial console if you free UART1 from console=ttyS0.
 *     Self-consistent in the DS (TXD on the odd pin) — and it works as labelled.
 *   - UART1 RTS/CTS pins (SODIMM 207/209, SIO1[6]/[7], DT uart13): a SECOND UART
 *     on the same J6 header (pins 5 and 4). RTS/CTS can never work as flow
 *     control here — the SIO UART groups are 2-pin — so these are free, and
 *     uart13 gives J6 a dedicated port with no console and no on-module FTDI
 *     sharing the net.
 *   - UART_B (SODIMM 236/238, JAJ silk “UART2”): tRoot only, not a Linux tty.
 *
 * USB-C: FUSB301 @ i2c00 0x25 (see ark-jaj-usb-init.sh for dual-role)
 *
 * I2C (005-HW-32 Table 2-8 — module level-shifts I2C0/I2C1 to 3.3 V open-drain):
 *   - I2C0: SODIMM 185 SCL / 187 SDA = SIO0[0]/[1] → DT &i2c00 (typically /dev/i2c-0)
 *     JAJ: 3.3 V pull-ups; J36 pins 4/5 (silk UART2/I2C0) as I2C0_SCL/SDA_EXT;
 *     also the Jetson-style 40-pin I2C0 pair (DevKit names pins 27/28).
 *     FUSB301 @ 0x25 lives on this controller in stock Modalix DT — expect 0x25 on
 *     i2cdetect for i2c00 even with nothing on the carrier header.
 *   - I2C1: SODIMM 189 SCL / 191 SDA = SIO0[2]/[3] → DT &i2c01 (typically /dev/i2c-1)
 *     JAJ: 2.2 kΩ to 3.3 V; Jetson-style 40-pin I2C1 (DevKit names pins 3/5).
 *     Do NOT load SiMa modalix-som-devkit-uart01 (re-muxes those pins as UART).
 *   - CAM_I2C: separate bus i2c52 (/dev/i2c-4) → FSUSB42 → dual IMX219 @ 0x10
 *   - I2C2: SODIMM 232/234 @ 1.8 V (not level-shifted like 0/1) — &i2c02 enabled
 *     for completeness; not the primary carrier test path.
 *
 * Bench: scripts/i2c-jaj-test.sh  (see docs/bringup-jaj.md § I2C0 / I2C1)
 */

/dts-v1/;
/plugin/;

&{/} {
	model = "ARK Just a Jetson with SiMa Modalix SoM";
	compatible = "ark,just-a-jetson", "simaai,modalix-som", "simaai,modalix";

	jaj_xclk0: jaj-xclk0 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		status = "okay";
	};

	jaj_xclk1: jaj-xclk1 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		status = "okay";
	};

	ark_jaj {
		compatible = "ark,just-a-jetson";
		status = "okay";
	};

	/*
	 * GPIO I2C mux for dual IMX219 (same address 0x10 on CAM_I2C).
	 * Must be a root node with i2c-parent, not a child of i2c52.
	 */
	cam_i2cmux: i2cmux {
		compatible = "i2c-mux-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		i2c-parent = <&i2c52>;
		/* CAM_MUX_SEL: Jetson GPIO06 → Modalix port6 line 6 (SiMa dual-cam DT) */
		mux-gpios = <&port6 6 0>;
		idle-state = <0>;

		/* CAM0 — CSI1 / J28 (CSI1_D0/D1/CLK) */
		i2c@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			jaj_imx219_0: imx219@10 {
				compatible = "sony,imx219";
				reg = <0x10>;
				status = "okay";
				clocks = <&jaj_xclk0>;
				clock-names = "xclk";
				rotation = <180>;
				orientation = <2>;

				port {
					jaj_cam0_ep: endpoint {
						clock-lanes = <0>;
						data-lanes = <1 2>;
						link-frequencies = /bits/ 64 <456000000>;
						remote-endpoint = <&csi10in>;
						clock-noncontinuous;
					};
				};
			};
		};

		/* CAM1 — CSI2 / J25 (CSI2_D0/D1/CLK) */
		i2c@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			jaj_imx219_1: imx219@10 {
				compatible = "sony,imx219";
				reg = <0x10>;
				status = "okay";
				clocks = <&jaj_xclk1>;
				clock-names = "xclk";
				rotation = <180>;
				orientation = <2>;

				port {
					jaj_cam1_ep: endpoint {
						clock-lanes = <0>;
						data-lanes = <1 2>;
						link-frequencies = /bits/ 64 <456000000>;
						remote-endpoint = <&csi20in>;
						clock-noncontinuous;
					};
				};
			};
		};
	};
};

/* ---- PWDN enables (port5); CAM_MUX_SEL is owned by i2c-mux-gpio on port6 ---- */

&port5 {
	/* Match SiMa dual-cam overlays: port5 GPIO6/7 = camera powerdown enables */
	cam0-pwdn-en {
		gpio-hog;
		gpios = <6 0>;
		output-high;
		line-name = "cam0_pwdn";
	};

	cam1-pwdn-en {
		gpio-hog;
		gpios = <7 0>;
		output-high;
		line-name = "cam1_pwdn";
	};
};

/*
 * USB0_VBUS_DETn (SODIMM 87 = SoM GPIO00_VBUS_DET) — input with a pull-up.
 *
 * JAJ drives this net from the FUSB301's open-drain INT_N (U24 pin 10) and leaves
 * R70 — the 47k pull-up to 1V8 — DNP, because a Jetson SoM presents that pin as an
 * input with an internal pull-up and the external one is redundant. Modalix does
 * not: the SoM DTS hogs SIO6[0] as `output-low` under the name "usb_uart60", so the
 * module drives the net low and can never read it. With the hog removed and nothing
 * pulling the net, an open-drain driver has no valid high either.
 *
 * So: drop the hog and bias the pad up, which is what the carrier already expects.
 * The net then means what it says — released = 1 (no pending event), INT_N asserted
 * = 0. Note JAJ names it active low (`..._DETn`) while the SoM pin name implies
 * active high, and that INT_N is an *interrupt*, not a VBUS level: it latches on
 * attach/detach and stays low until someone reads FUSB301 register 0x13. Read VBUS
 * state from STATUS (0x11) bit 3 over I2C, not from this pin.
 *
 * GPIO00's SIO assignment is not in the SoM data sheet (Table 3-2 starts at GPIO01 =
 * SIO6[1]); SIO6[0] follows that table's GPIO0x = SIO6[x] pattern and is confirmed on
 * hardware by the pin tracking INT_N. See docs/bringup-jaj.md.
 */
&{/sio@6/gpio@0x04061000/gpio@0/uart-hog} {
	status = "disabled";
};

&pins_gpio60_deafult {		/* SiMa's spelling; label is "deafult" in modalix-som.dtsi */
	bias-pull-up;
	input-enable;
};

&port6 {
	gpio-line-names =
		"usb0_vbus_det",	/* SODIMM 87  — FUSB301 INT_N, open drain, pulled up here */
		"gpio01",
		"gpio02",
		"gpio03",
		"gpio04",
		"gpio05",
		"cam_mux_sel",		/* SODIMM 130 — FSUSB42 select, owned by cam_i2cmux */
		"gpio07";

	/*
	 * Claim SIO6[0] as an input. Disabling the SoM's output-low hog is not enough:
	 * the DesignWare GPIO's direction register keeps whatever the previous boot
	 * stage left in it, and the kernel driver does not reset it — measured
	 * SWPORTA_DDR bit0 still set (output) with no hog in sight. An `input` hog
	 * makes the GPIO core drive the direction to input at probe.
	 */
	usb0-vbus-det-hog {
		gpio-hog;
		gpios = <0 0>;
		input;
		line-name = "usb0_vbus_det";
	};
};

/* Parent bus for CAM_I2C (SoM → FSUSB42 mux → both cameras) */
&i2c52 {
	status = "okay";
	clock-frequency = <400000>;
};

/* ---- CSI1 (CAM0/J28) + CSI2 (CAM1/J25) pipelines ---- */
/* CSI0 unused on JAJ for dual IMX219 (no connector to CSI0 lanes). */

&csi0 {
	status = "disabled";
};

&csi1 {
	status = "okay";
};

&axi_vdma1 {
	status = "okay";
};

&mipi_dphy_rx1 {
	status = "okay";
};

&v4l2video1 {
	status = "okay";
};

&v4l2vdma1 {
	status = "okay";
};

&csi10in {
	clock-lanes = <0>;
	data-lanes = <1 2>;
	link-frequencies = /bits/ 64 <456000000>;
	remote-endpoint = <&jaj_cam0_ep>;
	clock-noncontinuous;
};

&csi2 {
	status = "okay";
};

&axi_vdma2 {
	status = "okay";
};

&mipi_dphy_rx2 {
	status = "okay";
};

&v4l2video2 {
	status = "okay";
};

&v4l2vdma2 {
	status = "okay";
};

&csi20in {
	clock-lanes = <0>;
	data-lanes = <1 2>;
	link-frequencies = /bits/ 64 <456000000>;
	remote-endpoint = <&jaj_cam1_ep>;
	clock-noncontinuous;
};

/* ---- Remove old wrong sensors on i2c00/i2c01 if re-applied ---- */
/* (fresh overlay replaces nodes only for targets we touch) */

/*
 * Gold-finger I2C0 (SIO0 pins 0–1). Stock Modalix also places FUSB301 here.
 * Keep 400 kHz; external EEPROMs/sensors on J36 or 40-pin I2C0 share this bus.
 */
&i2c00 {
	status = "okay";
	clock-frequency = <400000>;
	#address-cells = <1>;
	#size-cells = <0>;

	jaj_fusb301: fusb301@25 {
		compatible = "fcs,fusb301", "onnn,fusb301";
		reg = <0x25>;
		status = "okay";

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			try-power-role = "source";
		};
	};
};

/*
 * Gold-finger I2C1 (SIO0 pins 2–3) — carrier / 40-pin I2C1.
 * Must stay I2C function (not uart01 alternate overlay).
 *
 * On-board:
 *   INA238 @ 0x45 (A0=A1=1) — VBAT power monitor, R14 = 1 mΩ shunt
 *   AT24CSW010 @ 0x50 (+ security 0x58) — unique ID for board serial
 * Kernel: prefer CONFIG_SENSORS_INA238; until then userspace
 *   scripts/ark-jaj-sys-power.py → /run/ark-jaj/sys-power/
 */
&i2c01 {
	status = "okay";
	clock-frequency = <400000>;
	#address-cells = <1>;
	#size-cells = <0>;

	/* shunt-resistor is in micro-ohms (1 mΩ = 1000) */
	jaj_ina238: ina238@45 {
		compatible = "ti,ina238";
		reg = <0x45>;
		shunt-resistor = <1000>;
		status = "okay";
	};

	/*
	 * Memory at 0x50; factory serial is on the security address 0x58
	 * (see ark-jaj-sys-power.py). at24 binds the memory window.
	 */
	jaj_id_eeprom: eeprom@50 {
		compatible = "atmel,24c01";
		reg = <0x50>;
		pagesize = <16>;
		size = <128>;
		status = "okay";
	};
};

/* I2C2 gold finger @ 1.8 V (SIO0 pins 4–5) — optional; primary tests use 0/1 */
&i2c02 {
	status = "okay";
	clock-frequency = <400000>;
};

&pcie0_rc {
	status = "okay";
};

&pcie2_rc {
	status = "okay";
};

&pcie3_rc {
	status = "okay";
};

&xgmac0 {
	status = "okay";
};

/*
 * UART1 — generic (application) serial.
 * SoC: uart12 @ 0x0401a000, pinctrl uart2_group = SIO1 pins 4–5 (TX/RX only).
 * Electrically shared with SoM on-module FTDI (USB-C). Stock images also use this
 * as console=ttyS0; move console to UART0 (uart42) or drop serial console to use
 * exclusively from userspace (see docs/bringup-jaj.md).
 *
 * On the JAJ J6 header this pair is reversed relative to the silkscreen — host TX
 * goes to J6 pin 2 and host RX to J6 pin 3, plus a 3V3 pull-up on pin 3.
 */
&uart12 {
	status = "okay";
};

/*
 * Second UART on the JAJ UART1 header (J6 pins 5 and 4).
 * SoC: uart13 @ 0x0401c000, pinctrl uart3_group = SIO1 pins 6–7 → SODIMM 207/209,
 * which JAJ wires as UART1_RTS#/UART1_CTS# to J6 pin 5 / pin 4.
 *
 * Those pins are dead weight otherwise: a SIO UART group is only 2 pins wide, so
 * the controller has no RTS/CTS to put there and `crtscts` can never work. Enabling
 * uart13 turns them into a real port, and unlike uart12 it carries no console, no
 * getty, and no on-module FT230X in parallel on the net.
 *
 * Direction on J6 follows the same even=RX / odd=TX rule, so SIO1[7] is the TX pad.
 * Confirm which J6 pin it lands on before wiring; if the SoC's TX lands on pin 4,
 * that net needs a 3V3 pull-up added for the same LSF0108 reason as pin 3, while
 * pin 5 already has one (R60). See docs/bringup-jaj.md.
 */
&uart13 {
	status = "okay";
};

/*
 * Pin the ttyS numbering. Without serialN aliases the 8250 line number comes from
 * probe order, so adding uart13 (sio@1, after uart12) would have pushed UART0 from
 * /dev/ttyS1 to /dev/ttyS2 and quietly broken every "UART0 = ttyS1" reference —
 * including console=ttyS1 in the "free UART1 from console" procedure.
 *
 * Alias values must be literal path strings: an overlay cannot resolve &label to a
 * path at compile time (dtc emits a phandle, which /aliases cannot hold).
 */
&{/aliases} {
	/* UART1 → /dev/ttyS0 (console; SoM USB-C + J6 pins 2/3) */
	serial0 = "/sio@1/uart@0x0401a000";
	/* UART0 → /dev/ttyS1 (J5 header; verified TX+RX) */
	serial1 = "/sio@4/uart@0x0404a000";
	/* UART1 RTS/CTS pins → /dev/ttyS2 (J6 pins 5/4) */
	serial2 = "/sio@1/uart@0x0401c000";
};

/*
 * UART0 — second general-purpose UART on JAJ (header near UART0 silk / 3.3 V side).
 * SoC: uart42 @ 0x0404a000, SIO4 pins 4–5. Enable for console=ttyS1 when UART1
 * is reserved for an application.
 */
&uart42 {
	status = "okay";
};
