// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * ARK Jetson PAB Carrier V3 with SiMa.ai Modalix SoM
 *
 * Hardware: ARK Jetson PAB Carrier V3 Rev 3.0 schematic + Modalix 005-HW-32 pin map.
 *
 * KSZ8795CLX (sheet 15) — SoM GbE is dead until SWITCH_RSTn is high:
 *   - SWITCH_RSTn = SODIMM 211 = SIO7[1] = port7 line 1 → hog output-high
 *   - SW_PMEn     = SODIMM 216 = SIO7[3] = port7 line 3 → hog output-high
 *   - FMU_RST_REQ = SODIMM 228 = SIO7[5] = port7 line 5 → hog output-low
 *
 * gpio70/port7 is already status=okay in modalix-som_16g.dtb.
 * VBUS_SENSE_BOOTLOADER = SODIMM 206 = SIO6[7] = port6 line 7 → hog
 * output-high so ARKV6X FMU enumerates on USB (/dev/ttyACM0).
 * Do not hog CAM0/CAM1 PWDN (SIO5[6]/[7]) or FUSB INT_N (SIO6[0]) at
 * gpiochip probe next to the KSZ hogs: that brown out 5 V PAB at
 * Starting kernel. Camera PWDN is imx219 reset-gpios (released high at
 * sensor probe, after the switch is already up).
 *
 * Dual IMX219 (FSUSB42 mux, same as JAJ electrically on I2C/PWDN):
 *   - CAM_I2C = i2c52 → FSUSB42, CAM_MUX_SEL = port6 line 6
 *   - Lanes differ from JAJ. Jetson PAB V3 dual overlay is CSI0+CSI2
 *     (serial_a + serial_c); JAJ is CSI1+CSI2 (serial_b + serial_c).
 *   - CAM0 J28 sel=0 → CSI0 (csi@40c0000); CAM1 J25 sel=1 → CSI2
 *   - CAM0/CAM1 PWDN = port5 GPIO6/7 via reset-gpios, not gpio-hogs
 *
 * Copper is 10/100. Keep MAC snps,ps-speed = 1000 (in-band SGMII / 1G GMII)
 * and limit the Marvell 88E1510 with max-speed = <100>.
 *
 * FUSB301 @ i2c00 0x25 (same chip as JAJ). INT_N is USB0_VBUS_DETn = SIO6[0].
 * Disabling the SoM uart-hog and hogging that pad as input + pull-up (JAJ)
 * next to the KSZ hogs resets 5 V PAB at Starting kernel. I2C to 0x25 is
 * enough for ark-jaj-usb-init.sh (DEVICEID 0x12). Leave SIO6[0] alone.
 *
 * M.2 Key M NVMe is PCIE0 (stock SoM DTB already okay; keep it explicit).
 */

/dts-v1/;
/plugin/;

&{/} {
	model = "ARK Jetson PAB V3 with SiMa Modalix SoM";
	compatible = "ark,jetson-pab-v3", "simaai,modalix-som", "simaai,modalix";

	pabv3_xclk0: pabv3-xclk0 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		status = "okay";
	};

	pabv3_xclk1: pabv3-xclk1 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		status = "okay";
	};

	ark_pab_v3 {
		compatible = "ark,jetson-pab-v3";
		status = "okay";
	};

	/*
	 * GPIO I2C mux for dual IMX219 (same address 0x10 on CAM_I2C).
	 * Must be a root node with i2c-parent, not a child of i2c52.
	 */
	cam_i2cmux: i2cmux {
		compatible = "i2c-mux-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		i2c-parent = <&i2c52>;
		mux-gpios = <&port6 6 0>;
		idle-state = <0>;

		/* CAM0 — CSI0 / J28 (PAB V3; JAJ uses CSI1 here) */
		i2c@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			pabv3_imx219_0: imx219@10 {
				compatible = "sony,imx219";
				reg = <0x10>;
				status = "okay";
				clocks = <&pabv3_xclk0>;
				clock-names = "xclk";
				reset-gpios = <&port5 6 0>;
				rotation = <180>;
				orientation = <2>;

				port {
					pabv3_cam0_ep: endpoint {
						clock-lanes = <0>;
						data-lanes = <1 2>;
						link-frequencies = /bits/ 64 <456000000>;
						remote-endpoint = <&csi00in>;
						clock-noncontinuous;
					};
				};
			};
		};

		/* CAM1 — CSI2 / J25 */
		i2c@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			pabv3_imx219_1: imx219@10 {
				compatible = "sony,imx219";
				reg = <0x10>;
				status = "okay";
				clocks = <&pabv3_xclk1>;
				clock-names = "xclk";
				reset-gpios = <&port5 7 0>;
				rotation = <180>;
				orientation = <2>;

				port {
					pabv3_cam1_ep: endpoint {
						clock-lanes = <0>;
						data-lanes = <1 2>;
						link-frequencies = /bits/ 64 <456000000>;
						remote-endpoint = <&csi20in>;
						clock-noncontinuous;
					};
				};
			};
		};
	};
};

&xgmac0 {
	status = "okay";
	max-speed = <100>;
};

&{/ethernet@a800000/mdio0/ethernet-phy@0} {
	max-speed = <100>;
};

&port7 {
	switch-rst-n-hog {
		gpio-hog;
		gpios = <1 0>;
		output-high;
		line-name = "switch_rst_n";
	};

	sw-pmen-hog {
		gpio-hog;
		gpios = <3 0>;
		output-high;
		line-name = "sw_pmen";
	};

	fmu-rst-req-hog {
		gpio-hog;
		gpios = <5 0>;
		output-low;
		line-name = "fmu_rst_req";
	};
};

&port6 {
	vbus-sense-bootloader-hog {
		gpio-hog;
		gpios = <7 0>;
		output-high;
		line-name = "vbus_sense_bootloader";
	};
};

&i2c00 {
	status = "okay";
	clock-frequency = <400000>;
	#address-cells = <1>;
	#size-cells = <0>;

	pabv3_fusb301: fusb301@25 {
		compatible = "fcs,fusb301", "onnn,fusb301";
		reg = <0x25>;
		status = "okay";

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			try-power-role = "source";
		};
	};
};

/* Parent bus for CAM_I2C (SoM → FSUSB42 → both cameras) */
&i2c52 {
	status = "okay";
	clock-frequency = <400000>;
};

/* CSI0 (CAM0/J28) + CSI2 (CAM1/J25) — PAB V3 lanes, not JAJ CSI1+CSI2 */
&csi0 {
	status = "okay";
};

&axi_vdma0 {
	status = "okay";
};

&mipi_dphy_rx0 {
	status = "okay";
};

&v4l2video0 {
	status = "okay";
};

&v4l2vdma0 {
	status = "okay";
};

&csi00in {
	clock-lanes = <0>;
	data-lanes = <1 2>;
	link-frequencies = /bits/ 64 <456000000>;
	remote-endpoint = <&pabv3_cam0_ep>;
	clock-noncontinuous;
};

&csi1 {
	status = "disabled";
};

&csi2 {
	status = "okay";
};

&axi_vdma2 {
	status = "okay";
};

&mipi_dphy_rx2 {
	status = "okay";
};

&v4l2video2 {
	status = "okay";
};

&v4l2vdma2 {
	status = "okay";
};

&csi20in {
	clock-lanes = <0>;
	data-lanes = <1 2>;
	link-frequencies = /bits/ 64 <456000000>;
	remote-endpoint = <&pabv3_cam1_ep>;
	clock-noncontinuous;
};

&pcie0_rc {
	status = "okay";
};

&pcie2_rc {
	status = "okay";
};

&pcie3_rc {
	status = "okay";
};
