// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * ARK Jetson PAB Carrier V3 with SiMa.ai Modalix SoM
 *
 * Hardware: ARK Jetson PAB Carrier V3 Rev 3.0 schematic + Modalix 005-HW-32 pin map.
 * Jetson product counterpart: ark_jetson_kernel products/PAB_V3 (dual IMX219, KSZ8795).
 *
 * Cameras (schematic sheet 14 — dual CSI, FSUSB42 like JAJ, not PAB quad/TCA9546):
 *   - Shared CAM_I2C → FSUSB42UMX (U11) → CAM0 / CAM1 @ 0x10
 *   - CAM_MUX_SEL = SODIMM 130 = GPIO06 = port6 line 6
 *   - CAM0/CAM1 PWDN = SODIMM 114/120 = SIO5[6]/[7] (Modalix Table 2-5).
 *     Do not gpio-hog these at boot on this carrier: together with the KSZ
 *     reset hog they brown out the 5 V PAB rail (kernel resets at ~1.2 s).
 *   - CAM0 (J28) 2-lane → CSI0 D0/D1/CLK
 *   - CAM1 (J25) 2-lane → CSI2 D0/D1/CLK
 *   - Linux: i2c52 = CAM_I2C parent
 *
 * On-board Ethernet switch (KSZ8795CLX, sheet 15) — critical for carrier GbE:
 *   - SWITCH_RSTn = SODIMM 211 = GPIO09_AUD_MCLK = SIO7[1] = port7 line 1
 *     Active-low; drive HIGH to release KSZ8795 from reset (Jetson MB1 holds AC.06 high).
 *   - SW_PMEn     = SODIMM 216 = GPIO11 = SIO7[3] = port7 line 3 → KSZ PME_N (10k)
 *     Drive HIGH so PME stays deasserted.
 *   - KSZ SPI slave is Modalix SPI0 (SODIMM 89/91/93/95 = nvs_spi0), 1.8 V,
 *     schematic sheet 15. Unmanaged switch still forwards once RST_N is high.
 *     Jetson PAB_V3 uses SPI1 for the same net; do not enable nvs_spi1 here
 *     (that is the SoM force-recovery / IMU path).
 *   - SoM MAC → switch port 1; KSZ8795CLX user ports are 10/100 — SoM link
 *     must be 100 Mbps (stock Modalix DTB sets snps,ps-speed = 1000).
 *
 * FMU / USB (same PAB family nets as ark-pab.dtso):
 *   - VBUS_SENSE_BOOTLOADER = SODIMM 206 = GPIO07 = port6 line 7 → output-high
 *   - FMU_RST_REQ           = SODIMM 228 = GPIO13 = port7 line 5 → output-low
 *   - No USB2_USBSS0_VBUS_EN net on V3 (USB-A path differs from PAB Rev3).
 *
 * UART / I2C / SPI (gold-finger, same as JAJ/PAB):
 *   - UART1 = uart12 = ttyS0 (SoM USB-C FTDI console only on this SoM rev)
 *   - UART0 = uart42 = ttyS1
 *   - I2C0: FUSB301 @ 0x25
 *   - I2C1: AT24CSW010 unique ID EEPROM @ 0x50 (security @ 0x58)
 *   - SPI0: nvs_spi0 header spidev
 *
 * FC link matrix (Modalix SoM rev used for bring-up — see docs/bringup-pab-v3.md):
 *   - USB (VBUS_SENSE_BOOTLOADER high from U-Boot) — works → /dev/ttyACM0
 *   - Ethernet via KSZ8795 — works (FC should use DHCP on same LAN as SoM)
 *   - UART1 → FC Telem2 — NOT available on this Modalix SoM revision
 * Camera / SPI-managed KSZ / remaining headers: still bring-up.
 */

/dts-v1/;
/plugin/;

&{/} {
	model = "ARK Jetson PAB V3 with SiMa Modalix SoM";
	compatible = "ark,jetson-pab-v3", "simaai,modalix-som", "simaai,modalix";

	pabv3_xclk0: pabv3-xclk0 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		status = "okay";
	};

	pabv3_xclk1: pabv3-xclk1 {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <24000000>;
		status = "okay";
	};

	ark_pab_v3 {
		compatible = "ark,jetson-pab-v3";
		status = "okay";
	};

	/*
	 * Dual IMX219 @ 0x10 behind FSUSB42 (same pattern as ark-jaj.dtso).
	 * Must be a root node with i2c-parent, not a child of i2c52.
	 */
	cam_i2cmux: i2cmux {
		compatible = "i2c-mux-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		i2c-parent = <&i2c52>;
		/* CAM_MUX_SEL: SODIMM 130 = GPIO06 = port6 line 6 */
		mux-gpios = <&port6 6 0>;
		idle-state = <0>;

		/* CAM0 — CSI0 / J28 */
		i2c@0 {
			reg = <0>;
			#address-cells = <1>;
			#size-cells = <0>;

			pabv3_imx219_0: imx219@10 {
				compatible = "sony,imx219";
				reg = <0x10>;
				status = "okay";
				clocks = <&pabv3_xclk0>;
				clock-names = "xclk";
				rotation = <180>;
				orientation = <2>;

				port {
					pabv3_cam0_ep: endpoint {
						clock-lanes = <0>;
						data-lanes = <1 2>;
						link-frequencies = /bits/ 64 <456000000>;
						remote-endpoint = <&csi00in>;
						clock-noncontinuous;
					};
				};
			};
		};

		/* CAM1 — CSI2 / J25 */
		i2c@1 {
			reg = <1>;
			#address-cells = <1>;
			#size-cells = <0>;

			pabv3_imx219_1: imx219@10 {
				compatible = "sony,imx219";
				reg = <0x10>;
				status = "okay";
				clocks = <&pabv3_xclk1>;
				clock-names = "xclk";
				rotation = <180>;
				orientation = <2>;

				port {
					pabv3_cam1_ep: endpoint {
						clock-lanes = <0>;
						data-lanes = <1 2>;
						link-frequencies = /bits/ 64 <456000000>;
						remote-endpoint = <&csi20in>;
						clock-noncontinuous;
					};
				};
			};
		};
	};
};

/*
 * Camera PWDN (SIO5[6]/[7] = SODIMM 114/120) is left un-hogged. Driving both
 * high at the same instant as SWITCH_RSTn / SW_PMEn resets this SoM on 5 V
 * PAB power. Enable from userspace later if cameras are needed.
 */

/*
 * USB0_VBUS_DETn — drop SoM output-low hog; bias as input with pull-up
 * (same FUSB INT_N story as JAJ/PAB).
 */
&{/sio@6/gpio@0x04061000/gpio@0/uart-hog} {
	status = "disabled";
};

&pins_gpio60_deafult {
	bias-pull-up;
	input-enable;
};

&port6 {
	gpio-line-names =
		"usb0_vbus_det",
		"gpio01",
		"gpio02",
		"gpio03",
		"gpio04",
		"gpio05",
		"cam_mux_sel",		/* SODIMM 130 — FSUSB42 SEL, owned by cam_i2cmux */
		"vbus_sense_bl";	/* SODIMM 206 — VBUS_SENSE_BOOTLOADER (FMU USB) */

	usb0-vbus-det-hog {
		gpio-hog;
		gpios = <0 0>;
		input;
		line-name = "usb0_vbus_det";
	};

	/*
	 * VBUS_SENSE_BOOTLOADER (SIO6[7]) is driven high from U-Boot
	 * (gpios-ark-pab-v3.cmd). A Linux output hog of this pad together
	 * with the KSZ resets this SoM at kernel probe on 5 V PAB power.
	 */
};

/*
 * port7 = SIO7 = GPIO08..GPIO15 (Modalix Table 3-2).
 * PAB V3 critical carrier enables live here.
 */
&port7 {
	gpio-line-names =
		"gpio08_fan_tach",	/* SODIMM 208 */
		"switch_rst_n",		/* SODIMM 211 — KSZ8795 RST_N (active-low) */
		"gpio10",		/* SODIMM 212 */
		"sw_pmen",		/* SODIMM 216 — KSZ PME_N / SW_PMEn */
		"gpio12",		/* SODIMM 218 */
		"fmu_rst_req",		/* SODIMM 228 — FMU_RST_REQ (keep low) */
		"gpio14_fan_pwm",	/* SODIMM 230 */
		"gpio15";

	/*
	 * SWITCH_RSTn / SW_PMEn / FMU_RST_REQ are driven from U-Boot
	 * (recipes-bsp/u-boot/files/gpios-ark-pab-v3.cmd) so the KSZ is
	 * out of reset before the kernel. Linux gpio-hogs of these pads
	 * at probe brown out this SoM on 5 V PAB power.
	 */
};

/* Parent bus for CAM_I2C (SoM → FSUSB42 → both cameras) */
&i2c52 {
	status = "okay";
	clock-frequency = <400000>;
};

/* ---- CSI0 (CAM0/J28) + CSI2 (CAM1/J25) — PAB V3 wiring (not JAJ CSI1/CSI2) ---- */

&csi0 {
	status = "okay";
};

&axi_vdma0 {
	status = "okay";
};

&mipi_dphy_rx0 {
	status = "okay";
};

&v4l2video0 {
	status = "okay";
};

&v4l2vdma0 {
	status = "okay";
};

&csi00in {
	clock-lanes = <0>;
	data-lanes = <1 2>;
	link-frequencies = /bits/ 64 <456000000>;
	remote-endpoint = <&pabv3_cam0_ep>;
	clock-noncontinuous;
};

/* CSI1 unused for dual-cam V3 layout */
&csi1 {
	status = "disabled";
};

&csi2 {
	status = "okay";
};

&axi_vdma2 {
	status = "okay";
};

&mipi_dphy_rx2 {
	status = "okay";
};

&v4l2video2 {
	status = "okay";
};

&v4l2vdma2 {
	status = "okay";
};

&csi20in {
	clock-lanes = <0>;
	data-lanes = <1 2>;
	link-frequencies = /bits/ 64 <456000000>;
	remote-endpoint = <&pabv3_cam1_ep>;
	clock-noncontinuous;
};

/* ---- Host I2C / SPI / UART / PCIe / Ethernet MAC ---- */

&i2c00 {
	status = "okay";
	clock-frequency = <400000>;
	#address-cells = <1>;
	#size-cells = <0>;

	pabv3_fusb301: fusb301@25 {
		compatible = "fcs,fusb301", "onnn,fusb301";
		reg = <0x25>;
		status = "okay";

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			try-power-role = "source";
		};
	};
};

&i2c01 {
	status = "okay";
	clock-frequency = <400000>;
	#address-cells = <1>;
	#size-cells = <0>;

	/* AT24CSW010 unique ID — memory @ 0x50, security window @ 0x58 */
	pabv3_id_eeprom: eeprom@50 {
		compatible = "atmel,24c01";
		reg = <0x50>;
		pagesize = <16>;
		size = <128>;
		status = "okay";
	};
};

&i2c02 {
	status = "okay";
	clock-frequency = <400000>;
};

&nvs_spi0 {
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	pabv3_spidev0: spidev@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <10000000>;
		status = "okay";
	};
};

/* nvs_spi1 is SoM SPI1 (SODIMM 104–112): force-recovery QSPI / IMU, not KSZ. */

&pcie0_rc {
	status = "okay";
};

&pcie2_rc {
	status = "okay";
};

&pcie3_rc {
	status = "okay";
};

/* SoM MAC into the KSZ8795 (10/100 switch — not 1G) */
&xgmac0 {
	status = "okay";
	/*
	 * MAC datapath stays 1G GMII (stock snps,ps-speed = 1000) for
	 * in-band SGMII. Limit the Marvell 88E1510 to 100 so it ANs with
	 * the KSZ; do not set ps-speed = 100 (that is MAC SS, not copper).
	 */
	max-speed = <100>;
};

&{/ethernet@a800000/mdio0/ethernet-phy@0} {
	max-speed = <100>;
};

&uart12 {
	status = "okay";
};

&uart13 {
	status = "okay";
};

&{/aliases} {
	serial0 = "/sio@1/uart@0x0401a000";
	serial1 = "/sio@4/uart@0x0404a000";
	serial2 = "/sio@1/uart@0x0401c000";
};

&uart42 {
	status = "okay";
};
